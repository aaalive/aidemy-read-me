CREATE TABLE Progress (
    id TEXT NOT NULL PRIMARY KEY,
    profileId TEXT NOT NULL,
    courseId TEXT NOT NULL,
    completedLessons INTEGER NOT NULL DEFAULT 0,
    totalLessons INTEGER NOT NULL,
    lastUpdatedEpochMillis INTEGER NOT NULL,
    FOREIGN KEY (profileId) REFERENCES Profile(id) ON DELETE CASCADE
);

upsertProgress:
INSERT OR REPLACE INTO Progress (id, profileId, courseId, completedLessons, totalLessons, lastUpdatedEpochMillis)
VALUES (?, ?, ?, ?, ?, ?);

selectProgressForProfile:
SELECT * FROM Progress WHERE profileId = ?;
